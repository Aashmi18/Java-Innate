6//HashBuilder


import java.util.HashSet;
public class Main {
    public static void main(String[] args) {
        HashSet<String> set1 = new HashSet<>();
        HashSet<String> set2 = new HashSet<>();
        set1.add("Apple");
        set1.add("Banana");
        set2.add("Mango");
        set2.add("Orange");
        set1.addAll(set2);
        System.out.println("After addAll: " + set1);
        System.out.println("HashCode: " + set1.hashCode());
        System.out.println("Is Empty: " + set1.isEmpty());
        set1.remove("Banana");
        System.out.println("After remove: " + set1);
        set1.removeAll(set2);
        System.out.println("After removeAll: " + set1);
        set1.add("Apple");
        set1.add("Grapes");
        set2.clear();
        set2.add("Apple");
        set2.add("Mango");
        set1.retainAll(set2);
        System.out.println("After retainAll: " + set1);
        System.out.println("Size: " + set1.size());
    }
}



