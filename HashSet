3//Enum


import java.util.EnumSet;
enum Day {
    MONDAY, TUESDAY, WEDNESDAY
}
public class Main {
    public static void main(String[] args) {
        EnumSet<Day> set = EnumSet.noneOf(Day.class);
        set.add(Day.MONDAY);
        set.add(Day.TUESDAY);
        System.out.println(set);
        set.remove(Day.MONDAY);
        System.out.println(set);
    }
}


